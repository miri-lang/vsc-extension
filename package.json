{
    "name": "miri-language",
    "displayName": "Miri Programming Language",
    "description": "Syntax highlighting and language support for the Miri programming language.",
    "version": "0.3.0",
    "publisher": "MiriLang",
    "author": "Viacheslav Shynkarenko",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/miri-lang/vsc-extension"
    },
    "bugs": {
        "url": "https://github.com/miri-lang/vsc-extension/issues"
    },
    "keywords": [
        "miri",
        "language",
        "syntax",
        "gpu",
        "compute",
        "stdlib",
        "testing"
    ],
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "scripts": {
        "package": "npx @vscode/vsce package",
        "test": "vscode-tmgrammar-test \"tests/**/*.mi\""
    },
    "devDependencies": {
        "vscode-tmgrammar-test": "^0.1.1"
    },
    "contributes": {
        "languages": [
            {
                "id": "miri",
                "aliases": [
                    "Miri",
                    "miri"
                ],
                "extensions": [
                    ".mi"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "miri",
                "scopeName": "source.miri",
                "path": "./syntaxes/miri.tmLanguage.json"
            }
        ]
    }
}
