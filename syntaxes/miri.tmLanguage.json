{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Miri",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.shebang.miri",
                    "match": "^#!.*$"
                },
                {
                    "name": "comment.line.double-slash.miri",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.miri",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#comments"
                        }
                    ]
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.regexp.miri",
                    "begin": "re\"",
                    "end": "\"[igmsu]*",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.regexp.miri",
                    "begin": "re'",
                    "end": "'[igmsu]*",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.interpolated.miri",
                    "begin": "f\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.embedded.line.miri",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "$self"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.interpolated.miri",
                    "begin": "f'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        },
                        {
                            "name": "meta.embedded.line.miri",
                            "begin": "\\{",
                            "end": "\\}",
                            "patterns": [
                                {
                                    "include": "$self"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.miri",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.miri",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.miri",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.miri",
                    "match": "\\b0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\\b"
                },
                {
                    "name": "constant.numeric.binary.miri",
                    "match": "\\b0[bB][01]+(?:_[01]+)*\\b"
                },
                {
                    "name": "constant.numeric.octal.miri",
                    "match": "\\b0[oO][0-7]+(?:_[0-7]+)*\\b"
                },
                {
                    "name": "constant.numeric.float.miri",
                    "match": "\\b[0-9]+(?:_[0-9]+)*\\.[0-9]+(?:_[0-9]+)*(?:[eE][+-]?[0-9]+(?:_[0-9]+)*)?\\b"
                },
                {
                    "name": "constant.numeric.float.miri",
                    "match": "\\b[0-9]+(?:_[0-9]+)*[eE][+-]?[0-9]+(?:_[0-9]+)*\\b"
                },
                {
                    "name": "constant.numeric.integer.miri",
                    "match": "\\b[0-9]+(?:_[0-9]+)*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.miri",
                    "match": "\\b(if|else|unless|for|forall|while|do|until|forever|return|match|default|in|break|continue|await|spawn|parallel|from)\\b"
                },
                {
                    "name": "keyword.operator.logical.miri",
                    "match": "\\b(or|and|not)\\b"
                },
                {
                    "name": "storage.type.miri",
                    "match": "\\b(let|var|const|type|struct|enum|class|trait|fn|async|gpu)\\b"
                },
                {
                    "name": "storage.modifier.miri",
                    "match": "\\b(public|protected|shared|private|abstract|runtime|intrinsic|must_use|host|out)\\b"
                },
                {
                    "name": "keyword.other.miri",
                    "match": "\\b(extends|implements|includes|is|use|as|system|local)\\b"
                },
                {
                    "name": "variable.language.miri",
                    "match": "\\b(self|super|Self|frame|kernel)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.miri",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.miri",
                    "match": "\\bNone\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.gpu.miri",
                    "match": "\\b(global_idx|thread_idx|block_idx|barrier)\\b"
                },
                {
                    "name": "support.function.builtin.math.miri",
                    "match": "\\b(abs|min|max|pow|sqrt|floor|ceil|round|sin|cos|tan|log|exp|tanh|exp2|log2|atan2|fract|clamp|mix|smoothstep|step|sign|dot|cross|normalize|length|distance|reflect|refract)(?=\\s*\\()"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.miri",
                    "match": "\\b(int|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|float|f32|f64|bool|String)\\b"
                },
                {
                    "name": "support.type.vector.gpu.miri",
                    "match": "\\b(Vec2|Vec3|Vec4)\\b"
                },
                {
                    "name": "entity.name.type.miri",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.miri"
                        }
                    }
                },
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.miri"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.compound.miri",
                    "match": "\\+=|-=|\\*=|/=|%="
                },
                {
                    "name": "keyword.operator.comparison.miri",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.miri",
                    "match": "="
                },
                {
                    "name": "keyword.operator.range.miri",
                    "match": "\\.\\.=|\\.\\."
                },
                {
                    "name": "keyword.operator.arrow.miri",
                    "match": "=>|->|<-"
                },
                {
                    "name": "keyword.operator.optional.miri",
                    "match": "\\?\\?|\\?"
                },
                {
                    "name": "keyword.operator.namespace.miri",
                    "match": "::"
                },
                {
                    "name": "keyword.operator.increment.miri",
                    "match": "\\+\\+|--"
                },
                {
                    "name": "keyword.operator.arithmetic.miri",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.bitwise.miri",
                    "match": "&|\\||\\^|~"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
                }
            ]
        }
    },
    "scopeName": "source.miri"
}
