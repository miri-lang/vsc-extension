// SYNTAX TEST "source.miri" "Syntax showcasing for Miri language"

#!/usr/bin/env miri

/* block comment
   /* nested block comment */
   still inside */

// Keywords and Control Flow
fn main()
    let x int = 10
    var y float = 20.5
    const z = None

    if x == 10
        print("x is 10")
    else if x > 5
        print("x is greater than 5")
    else
        print("x is small")

    unless y < 10.0
        print("y is large")

    for i in 1..10
        print(i)

    for i in 1..=10
        print(i)

    while x > 0: x -= 1

    do
        x += 1
    while x < 5

    until x == 10
        x += 1

    forever
        break

    match x
        1: print("one")
        2 | 3: print("two or three")
        n if n > 10: print("large")
        default: print("default")

// Types and Data Structures
type ID = int
struct Point
    x int
    y int

enum Status
    Active
    Inactive

class Person
    name String
    age int

    fn new(name String, age int) Person
        return Person { name, age }

trait Drawable
    fn draw()

trait SameAs
    fn same(other Self) bool

// Concurrency and Async
async fn fetch_data() String
    return "data"

async fn process()
    let data = await fetch_data()
    spawn worker()
    parallel
        task1()
        task2()

// GPU and System
gpu fn compute(buffer list[float])
    let i = global_idx
    buffer[i] *= 2.0

// GPU residency bindings and kernels
gpu let device_data = Array<f32, 1024>()
gpu var scratch = Array<f32, 256>()

// GPU parallel launch (forall / gpu forall)
fn simulate(out data list[f32])
    forall i in 0..1024
        data[i] = data[i] * 2.0
    gpu forall i in 0..1024
        data[i] = clamp(data[i], 0.0, 1.0)

// Vector builtins (GPU)
gpu fn shade(out pixels list[Vec4])
    let n = normalize(Vec3(1.0, 0.0, 0.0))
    let d = dot(n, Vec3(0.0, 1.0, 0.0))
    let c = cross(n, Vec3(0.0, 0.0, 1.0))
    let m = mix(0.0, 1.0, fract(frame.time))
    pixels[global_idx] = Vec4(d, m, length(c), 1.0)

// Per-frame inputs and thread builtins
gpu fn animate(out grid list[f32])
    let t = frame.time
    let mx = frame.mouse_x
    barrier()
    grid[thread_idx] = t + mx

// Residency-polymorphic function
fn scale(host data list[f32], factor f32)
    forall i in 0..data.length()
        data[i] *= factor

// Attributes — a closed set; an unknown one is a compile error
@must_use
enum Receipt
    Written(int)

@non_exhaustive
enum FsError
    NotFound(String)

@deprecated("acquire a Clock and use clock.now()")
fn legacy_timestamp() int
    0

@test
fn addition_works()
    assert_eq(2 + 2, 4)

@test
@ignore("needs a fixture file")
fn reads_the_config()
    assert(false)

@test
@xfail("known bug, tracked upstream")
fn known_bug()
    assert_eq(1, 2)

// Static class members
class Duration
    millis int

    public static fn from_millis(n int) Duration
        Duration(millis: n)

// Imports
use system.io
use system.gpu.{local, shared}
use system.collections.list as L
use system.collections.queue
use system.collections.stack
use system.text
use system.json
use system.fs
use system.os
use system.time
use local.utils.math

// Modifiers
public fn pub_func()
private var priv_var
protected const PROT = 1
abstract class Base
runtime fn sys_call()
out fn capture_by_ref()

// Strings
let s1 = 'single quoted'
let s2 = "double quoted"
let f1 = f"formatted {x}"
let f2 = f'formatted {x}'
let r1 = re"[a-z]+"ig
let r2 = re'[a-z]+'igmsu

// Numbers
let num1 = 1_000_000
let num2 = 3.14159
let num3 = 1.5e10
let num4 = 2_500e-3
let hex = 0xFF_FF
let bin = 0b1010_0101
let oct = 0o777
let big = 1_000_000_000_000

// Integer types
let a i8 = 1
let b i16 = 2
let c i32 = 3
let d i64 = 4
let e i128 = 5
let g u8 = 6
let h u16 = 7
let j u32 = 8
let k u64 = 9
let l u128 = 10

// Operators
let sum = a + b
let diff = a - b
let prod = a * b
let quot = a / b
let modu = a % b
let eq = a == b
let neq = a != b
let geq = a >= b
let leq = a <= b
let and_ = a > 0 and b > 0
let or_ = a > 0 or b > 0
let not_ = not (a > 0)
let coalesce = maybe ?? 0
let ns = system::io::print
let arrow = fn(x int) int: x * 2
let ranged = 1..10
let inclusive = 1..=10
